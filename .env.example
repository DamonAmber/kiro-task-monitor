# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）
# 发版（npm run release / scripts/release.sh）时用到

# —— 公证凭据（Apple ID + App 专用密码方式）——
APPLE_ID=your-apple-id@example.com
# 在 https://appleid.apple.com › 登录与安全 › App 专用密码 生成
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# 10 位团队 ID，见 https://developer.apple.com/account （Membership 页）
APPLE_TEAM_ID=ABCDE12345

# —— 发布到 GitHub Releases 用的 token —— 
# 在 https://github.com/settings/tokens 生成（勾选 repo 权限）
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 签名证书不放这里：它在你的「登录」钥匙串里（见 RELEASE.md），electron-builder 会自动发现。
